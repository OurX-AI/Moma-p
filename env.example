# =============================================================================
# 环境配置模板
# =============================================================================
# 复制此文件为 .env 并根据实际环境修改配置

# =============================================================================
# 基础配置
# =============================================================================
DEBUG=false
APP_LOG_LEVEL=INFO

# =============================================================================
# 运行时数据目录（开发用仓库 data；安装态不配则默认 ~/）
# =============================================================================
#RUNTIME_DATA_DIR=

# =============================================================================
# 基础设施配置
# =============================================================================
# ========================数据库配置========================
# 数据库名称
DB_NAME=momacoder_service_data
# 数据库类型: postgresql/mysql/sqlite
DATABASE_TYPE=sqlite
# 数据库连接池配置
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# PostgreSQL 配置
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_USER=
POSTGRESQL_PASSWORD=

# MySQL 配置 (如果使用MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=

# =============================================================================
# 向量存储
# =============================================================================
# 引擎: lancedb | elasticsearch | opensearch
VECTOR_STORE_ENGINE=lancedb
VECTOR_STORE_MAPPING=es_doc_mapping.json

# Elasticsearch配置
ES_HOSTS=https://localhost:9200
ES_USERNAME=
ES_PASSWORD=
# 是否校验 ES 服务端 TLS 证书，本地自签证书可设为 false
ES_VERIFY_CERTS=false

# OpenSearch配置
OS_HOSTS=http://localhost:9200
OS_USERNAME=
OS_PASSWORD=

# ========================图数据库配置========================
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_POOL_SIZE=5
NEO4J_MAX_OVERFLOW=10

# ========================模型配置说明 见：app/config/xxx.json========================

# =============================================================================
# Web 工具配置 - Web Search / Fetch
# =============================================================================
# Tavily（搜索 + 正文抽取，https://tavily.com）
TAVILY_API_KEY=
# Brave 搜索（https://api.search.brave.com）
BRAVE_API_KEY=
# Serper 搜索（https://serper.dev，Google SERP，2500 次免费）
SERPER_API_KEY=
# Firecrawl 抓取（https://firecrawl.dev）
FIRECRAWL_API_KEY=
# Jina Reader 抓取（https://jina.ai/reader，Key 可选，无 Key 匿名限流）
JINA_API_KEY=
# web_search 主选 + 备选（备选留空=不回退；可选 tavily | brave | serper | duckduckgo）
WEB_SEARCH_PRIMARY=serper
WEB_SEARCH_FALLBACK=duckduckgo
# web_fetch 主选 + 备选（备选留空=不回退；可选 static | jina | tavily | firecrawl）
WEB_FETCH_PRIMARY=jina
WEB_FETCH_FALLBACK=static
# web_fetch 拉页后是否用会话同模型按 prompt 二次抽取（true=对齐 Claude；false=只回 markdown/text）
WEB_FETCH_LLM_EXTRACT=true

# ========================Skills Hub / GitHub========================
# skills.sh、GitHub 来源安装需拉取仓库文件；未配置时匿名请求易触发 GitHub API 限流（403）
# 在 GitHub Settings → Developer settings → Personal access tokens 创建，classic token 无需勾选额外 scope
GITHUB_TOKEN=
# 或使用 GH_TOKEN（与 GITHUB_TOKEN 二选一即可）
GH_TOKEN=

# =============================================================================
# Agent配置
# =============================================================================
# 会话存储方式：true=本地文件，false=数据库
ENABLE_LOCAL_SESSION_STORAGE=true
# 是否启用 cron 调度循环（多进程部署时仅一个进程设为 true）
ENABLE_CRON=true
# 同一会话新消息是否中断当前Agent：true=中断当前并以新消息优先；false=等待当前完成后排队处理
ENABLE_MESSAGE_INTERRUPT=true
# /stop 软中止后等待协作退出的宽限(秒)，超时则 cancel run；/kill 立即强杀
AGENT_RUN_HARD_KILL_GRACE_SEC=15
# Agent 单轮可并行执行的工具调用上限
MAX_PARALLEL_TOOL_WORKERS=8
# 跨 Actor 文件读写协调（file_state）
ENABLE_FILE_STATE_GUARD=true
# 文件工具强制路径在 workspace/runtime_data_dir 内，防止越界读写；关闭后无此限制
FILE_TOOL_WORKSPACE_BOUNDARY_ENABLED=false

# 是否向 Agent 暴露 powershell 工具（不设则按平台默认：Windows 开，Linux/macOS 关）
USE_POWERSHELL_TOOL=true

# 工具结果超长保存到文件
ENABLE_TOOL_RESULT_TRUNCATE=true
# 工具结果截断阈值（超限时落盘 workspace/tool_output，仅摘要进上下文）
TOOL_RESULT_TRUNCATE_MAX_LINES=2000   # 2000行
TOOL_RESULT_TRUNCATE_MAX_BYTES=51200   # 51200字节

# 会话上下文压缩控制（compact）
# 触发公式：overflow_basis >= CONTEXT_LIMIT - max_output_tokens - RESERVED
# overflow_basis：优先 input_tokens+cache_read_tokens+cache_write_tokens，否则 total_tokens
# 是否自动摘要压缩会话历史（true/false）
COMPACTION_AUTO=true
# 压缩后保留的最近消息条数（会再向左对齐完整 tool 轮）
COMPACTION_KEEP_LAST_N=10
# 触发压缩时预留的 token 缓冲（越大越早触发）
COMPACTION_RESERVED=13000
# 用于判断溢出的上下文上限（token）
COMPACTION_CONTEXT_LIMIT=64000

# 历史工具结果清空（prune）
# 仅清空 compactable 工具结果：保留最近 KEEP_RECENT 条，更早的换成短 stub
# 是否启用
COMPACTION_PRUNE=true
# 可参与清空的工具名（逗号分隔）；不在列表中的工具（如 skill）不会被 prune
COMPACTION_PRUNE_COMPACTABLE_TOOLS=read_file,bash,powershell,shell_process,grep_search,glob_search,web_search,web_fetch,write_file,replace_file_text,replace_file_multi_text,apply_patch
# 上下文溢出后 reactive compact 最大重试次数（每次失败会收紧 keep）
COMPACTION_REACTIVE_MAX_ATTEMPTS=3

# =============================================================================
# CodeBase 模块配置
# =============================================================================
# =============================================================================
# 四类能力（开关 + 细参放一起；关则该类不入库、对应检索不可用）
# =============================================================================
# 是否向 Agent 暴露 CodeBase 查询工具（关闭后仅保留后台扫描）
CODEBASE_ENABLED=true

# 单仓文件分析 worker 并发（所有向量管线共享）
CODE_ANALYSIS_FILE_WORKER_COUNT=10

# ① 行块/片段向量（line_chunk）—— similar 的唯一向量来源
#    分析：两类切片合并后 embedding 入库
#      a) 行窗切片：按行滑动窗口切源码
#      b) 符号体切片：整段函数/方法（及小类）源码
#    检索：search similar（按代码片段找相似实现）
CODE_ANALYSIS_LINE_CHUNK_ENABLED=true
# --- a) 行窗切片（按行滑动；与符号体 b 合并后入库）---
# 流程：先按 TARGET 行开窗 → 只向下扩展（续行/未闭合括号/Python 冒号块）→ 上限 MAX → 下一块起点=end-OVERLAP
# TARGET=5：初始窗口约 5 行（不是固定切成 5 行就入库，扩展后通常更长）
CODE_ANALYSIS_LINE_CHUNK_TARGET_LINES=5
# OVERLAP=1：相邻窗口重叠 1 行，减轻边界处语句被切断
CODE_ANALYSIS_LINE_CHUNK_OVERLAP_LINES=1
# MAX=200：单块向下扩展后最多约 200 行（防括号长期不闭合等导致块过大）
CODE_ANALYSIS_LINE_CHUNK_MAX_LINES=200
# --- b) 符号体切片（与行窗 a 并行，最后合并进同一 line_chunk 向量库）---
# 作用：按 AST 把「整段函数/方法/小类」源码整块向量化入库，方便 similar 一次命中完整实现
#      （行窗是碎块；符号体是整符号。重叠时优先保留符号体，行窗不重复写）
# 超限：该整段不入库（不截断重切），该区域仍可由行窗 a 覆盖
# FUNCTION=500：函数/方法整段 ≤500 行才整段入库；更大的函数跳过，只靠行窗
CODE_ANALYSIS_SYMBOL_BODY_MAX_LINES_FUNCTION=500
# CLASS=120：仅小类（≤120 行）才「整类」入库；大类不切整类，但是类的方法按 FUNCTION 入库
CODE_ANALYSIS_SYMBOL_BODY_MAX_LINES_CLASS=120
# 单条 embedding 最大字符数（行窗/符号体/摘要共用）：超限跳过不截断；批失败时再逐条跳过
CODE_ANALYSIS_EMBED_MAX_CHARS=12000

# ② 符号摘要向量（symbol_summary）—— 产品默认 A：ON
#    分析：对类/函数调 LLM 写摘要 → embedding 入库
#    检索：search related（按自然语言找相关符号/文件）
CODE_ANALYSIS_SYMBOL_SUMMARY_ENABLED=true
# 单次 LLM 打包摘要的符号数；1=逐条；建议 4~8；超长失败会折半重试直至单条
CODE_ANALYSIS_SYMBOL_SUMMARY_LLM_BATCH_SIZE=6
# 并行批次数（或 batch_size=1 时的并行符号数）；过高易 API 限流或 SQLite database is locked
CODE_ANALYSIS_SYMBOL_SUMMARY_LLM_CONCURRENCY=4
# NL→Code 检索增强—— 产品默认 A：OFF（开则为 D）
#    多视角 embed / 仓内词表 / token 加权
CODE_ANALYSIS_NL_TO_CODE_ENABLED=false
# NL→Code 查询 LLM 改写（需总开关开启；默认关；weak=resolve 弱召回才触发，always=每次 NL）
CODE_ANALYSIS_NL_REWRITE_ENABLED=false
CODE_ANALYSIS_NL_REWRITE_MODE=weak

# 是否启用仓库内全文/标识符 grep（resolve auto 并联通道）
CODE_ANALYSIS_CONTENT_GREP_ENABLED=true


# ③ CodeGraph 依赖图谱（非向量；结构边）
#    分析：建调用/依赖图；检索：related 补强、dependents/dependencies/callers 等
CODE_GRAPH_ENABLED=true
# related/定位是否融入 CodeGraph（默认关：定位与关系分离；关系用 dependents/callers）
CODE_ANALYSIS_RELATED_INCLUDE_GRAPH=false

# ④ MR 经验向量（pattern）
#    分析：experience analyze；检索：search pattern
MR_EXPERIENCE_ENABLED=true
MR_EXPERIENCE_MIN_QUALITY_SCORE=0.55
# 检索时是否按场景合并多条MR经验（基于 commit message 和改动文件模式分组）
MR_EXPERIENCE_MERGE_BY_SCENARIO=true
# MR经验首次分析回看天数（默认2年，增量扫描首次触发时使用）
MR_EXPERIENCE_LOOKBACK_DAYS=730
# 单次收集 MR 条目上限（保护性，防止极端活跃仓拉爆 git log）
MR_EXPERIENCE_MAX_COLLECT_PER_RUN=5000
# 单轮处理 PENDING 条目数（跨 tick 推进，支持多天完成；默认50，避免单次全仓耗尽 token）
MR_EXPERIENCE_PROCESS_BATCH_SIZE=50

# =============================================================================
# CodeGraph
# =============================================================================
# 实现选择：codegraph（开源 CLI，默认）| builtin（自研 Neo4j）
CODE_GRAPH_PROVIDER=codegraph

# =============================================================================
# 增量扫描
# =============================================================================
# 程序运行后是否自动扫描已登记仓库变更（code/lib 文件 + code 仓新 MR 经验，默认 300 秒一轮）
ENABLE_INCREMENTAL_SCAN=true
INCREMENTAL_SCAN_INTERVAL_SEC=300

# resolve 单通道超时（毫秒）；0=不限制。超时只丢该通道，其它通道仍融合
RESOLVE_CHANNEL_TIMEOUT_MS=120000
# doctor/setup embedding 探测超时（毫秒）
DOCTOR_EMBED_PROBE_TIMEOUT_MS=15000

# =============================================================================
# 代码仓分析（通用，跨能力）
# =============================================================================
LSP_ENABLED=true
